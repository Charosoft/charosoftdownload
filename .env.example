# ==========================================
# CHAROSOFT DOWNLOAD
# Environment configuration example
# ==========================================

# Backend
PORT=3000
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Media processing
TEMP_DOWNLOAD_DIR=./downloads
LIMIT_ANON_MB=50
LIMIT_USER_MB=900
MAX_MEDIA_DURATION_SECONDS=3600

# Media engine
YTDLP_PYTHON=python3
YTDLP_BIN=/usr/local/bin/yt-dlp

# Connexion avec Google (étape 5b) : identifiant client OAuth
GOOGLE_CLIENT_ID=776549541961-fjmrti6ojcos55pjtcv8uonr7bum73he.apps.googleusercontent.com
