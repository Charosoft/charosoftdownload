:root {
  --orange: #ff7a00;
  --orange-light: #ff9a3d;
  --bg: #08090b;
  --bg-2: #101216;
  --card: #15181d;
  --border: #252a31;
  --text: #ffffff;
  --muted: #a7adb7;
  --success: #22c55e;
  --error: #ef4444;
  --radius: 18px;
  --shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: var(--text);

  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(255, 122, 0, 0.12),
      transparent 32%
    ),
    var(--bg);

  min-height: 100vh;
  line-height: 1.5;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: default;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}

/* HEADER */

header {
  position: sticky;
  top: 0;
  z-index: 50;

  background: rgba(8, 9, 11, 0.78);
  backdrop-filter: blur(18px);

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.nav {
  height: 76px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 24px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;

  min-width: max-content;
}

.brand-mark {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  background:
    linear-gradient(
      145deg,
      var(--orange-light),
      var(--orange)
    );

  color: #090909;

  font-weight: 900;

  box-shadow:
    0 8px 25px rgba(255, 122, 0, 0.2);
}

.brand-name {
  font-weight: 800;
  letter-spacing: -0.04em;
  font-size: 17px;
}

.brand-name span {
  color: var(--orange-light);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 26px;

  color: var(--muted);
  font-size: 14px;
}

.nav-links a:hover {
  color: #fff;
}

.login {
  border: 1px solid var(--border);

  padding: 9px 15px;

  border-radius: 10px;

  color: #fff;

  transition: 0.2s;
}

.login:hover {
  border-color: rgba(255, 122, 0, 0.55);
  color: var(--orange-light);
}

.menu {
  display: none;

  background: transparent;
  border: 0;

  color: white;

  font-size: 24px;
}

/* HERO */

.hero {
  position: relative;

  padding: 105px 0 80px;

  overflow: hidden;
}

.hero::before {
  content: "";

  position: absolute;

  width: 500px;
  height: 500px;

  left: 50%;
  top: 50px;

  transform: translateX(-50%);

  background: rgba(255, 122, 0, 0.07);

  filter: blur(100px);

  border-radius: 50%;

  pointer-events: none;
}

.hero-content {
  position: relative;

  max-width: 900px;

  margin: auto;

  text-align: center;
}

.eyebrow {
  display: inline-flex;

  align-items: center;
  gap: 8px;

  padding: 7px 12px;

  border: 1px solid rgba(255, 122, 0, 0.22);

  background: rgba(255, 122, 0, 0.06);

  border-radius: 999px;

  color: var(--orange-light);

  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;

  margin-bottom: 24px;
}

.eyebrow-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: var(--orange);

  box-shadow: 0 0 12px var(--orange);
}

h1 {
  font-size: clamp(46px, 7vw, 82px);

  line-height: 0.98;

  letter-spacing: -0.065em;

  font-weight: 850;

  margin-bottom: 24px;
}

h1 span {
  color: var(--orange);
}

.hero-subtitle {
  max-width: 650px;

  margin: 0 auto 38px;

  color: var(--muted);

  font-size: clamp(16px, 2vw, 19px);
}

/* URL */

.url-box {
  display: flex;
  align-items: stretch;

  max-width: 820px;

  margin: 0 auto;

  padding: 7px;

  background: rgba(21, 24, 29, 0.92);

  border: 1px solid var(--border);

  border-radius: 16px;

  box-shadow: var(--shadow);

  transition: 0.25s;
}

.url-box:focus-within {
  border-color: rgba(255, 122, 0, 0.7);

  box-shadow:
    0 0 0 4px rgba(255, 122, 0, 0.08),
    var(--shadow);
}

.url-icon {
  width: 52px;

  display: grid;
  place-items: center;

  color: #777f8a;

  font-size: 21px;
}

#urlInput {
  min-width: 0;

  flex: 1;

  border: 0;
  outline: 0;

  background: transparent;

  color: white;

  font-size: 16px;

  padding: 0 10px;
}

#urlInput::placeholder {
  color: #666d77;
}

.analyze-btn {
  border: 0;

  border-radius: 11px;

  background: var(--orange);

  color: #0b0b0b;

  padding: 0 25px;

  font-weight: 800;

  letter-spacing: 0.02em;

  transition: 0.2s;
}

.analyze-btn:hover:not(:disabled) {
  background: var(--orange-light);

  transform: translateY(-1px);
}

.analyze-btn.loading {
  opacity: 0.75;
}

.supported {
  margin-top: 18px;

  color: #737a84;

  font-size: 12px;
}

.supported strong {
  color: #aeb4bd;

  font-weight: 600;
}

/* RESULT */

.result-area {
  max-width: 820px;

  margin: 0 auto;
}

.result-area.visible {
  animation: reveal 0.45s ease;
}

@keyframes reveal {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-card {
  margin-top: 28px;

  padding: 20px;

  border: 1px solid var(--border);

  border-radius: var(--radius);

  background:
    linear-gradient(
      145deg,
      #171a20,
      #111318
    );

  box-shadow: var(--shadow);

  text-align: left;
}

.media-info {
  display: flex;

  gap: 18px;

  align-items: center;

  padding-bottom: 20px;

  border-bottom: 1px solid var(--border);
}

.thumbnail {
  width: 150px;

  aspect-ratio: 16 / 9;

  border-radius: 12px;

  flex: 0 0 auto;

  background:
    linear-gradient(
      135deg,
      rgba(255, 122, 0, 0.75),
      rgba(10, 10, 10, 0.9)
    ),
    repeating-linear-gradient(
      45deg,
      transparent 0 8px,
      rgba(255, 255, 255, 0.04) 8px 16px
    );

  display: grid;

  place-items: center;

  font-size: 31px;
}

.media-meta {
  min-width: 0;
}

.source {
  color: var(--orange-light);

  text-transform: uppercase;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.08em;

  margin-bottom: 5px;
}

.media-title {
  font-size: 19px;

  font-weight: 750;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.duration {
  margin-top: 5px;

  color: var(--muted);

  font-size: 13px;
}

.format-title {
  padding: 20px 0 12px;

  font-size: 13px;

  color: #c9cdd3;

  font-weight: 700;
}

.formats {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 10px;
}

.format {
  padding: 14px;

  border: 1px solid var(--border);

  background: #111419;

  border-radius: 12px;

  transition: 0.2s;
}

.format:hover {
  border-color: rgba(255, 122, 0, 0.45);

  transform: translateY(-2px);
}

.format-top {
  display: flex;

  justify-content: space-between;

  gap: 8px;

  align-items: center;
}

.format-name {
  font-weight: 800;

  font-size: 14px;
}

.format-quality {
  color: var(--orange-light);

  font-size: 12px;

  font-weight: 700;
}

.format-size {
  color: #747b85;

  font-size: 11px;

  margin: 5px 0 12px;
}

.download-btn {
  width: 100%;

  border: 1px solid rgba(255, 122, 0, 0.35);

  background: rgba(255, 122, 0, 0.08);

  color: var(--orange-light);

  border-radius: 9px;

  padding: 8px;

  font-size: 12px;

  font-weight: 750;
}

.download-btn:hover {
  background: var(--orange);

  color: #111;
}

.notice {
  margin-top: 14px;

  padding: 12px 14px;

  border-radius: 10px;

  font-size: 13px;
}

.notice.error {
  color: #fecaca;

  background: rgba(239, 68, 68, 0.08);

  border: 1px solid rgba(239, 68, 68, 0.2);
}

.notice.success {
  color: #bbf7d0;

  background: rgba(34, 197, 94, 0.08);

  border: 1px solid rgba(34, 197, 94, 0.2);
}

/* FEATURES */

.section {
  padding: 75px 0;
}

.section-heading {
  max-width: 650px;

  margin-bottom: 32px;
}

.section-kicker {
  color: var(--orange);

  font-size: 12px;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: 0.12em;

  margin-bottom: 10px;
}

.section h2 {
  font-size: clamp(30px, 4vw, 46px);

  letter-spacing: -0.04em;

  line-height: 1.05;
}

.section-desc {
  color: var(--muted);

  margin-top: 12px;
}

.feature-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 14px;
}

.feature {
  padding: 24px;

  background: var(--card);

  border: 1px solid var(--border);

  border-radius: 16px;
}

.feature-icon {
  width: 40px;
  height: 40px;

  border-radius: 11px;

  display: grid;
  place-items: center;

  color: var(--orange-light);

  background: rgba(255, 122, 0, 0.09);

  border: 1px solid rgba(255, 122, 0, 0.14);

  margin-bottom: 18px;

  font-weight: 900;
}

.feature h3 {
  font-size: 16px;

  margin-bottom: 7px;
}

.feature p {
  color: var(--muted);

  font-size: 14px;
}

/* HOW */

.steps {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 14px;
}

.step {
  position: relative;

  padding: 24px;

  border-top: 1px solid var(--border);
}

.step-number {
  color: var(--orange);

  font-size: 12px;

  font-weight: 900;

  letter-spacing: 0.1em;

  margin-bottom: 20px;
}

.step h3 {
  margin-bottom: 7px;
}

.step p {
  color: var(--muted);

  font-size: 14px;
}

/* FOOTER */

footer {
  border-top: 1px solid var(--border);

  padding: 30px 0;

  color: #777e88;

  font-size: 12px;
}

.footer-inner {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;
}

.footer-brand {
  color: #fff;
}

.footer-links {
  display: flex;

  gap: 18px;
}

.footer-links a:hover {
  color: white;
}

/* MOBILE */

@media (max-width: 760px) {
  .container {
    width: min(100% - 28px, 620px);
  }

  .nav {
    height: 68px;
  }

  .nav-links {
    display: none;

    position: absolute;

    left: 14px;
    right: 14px;

    top: 64px;

    padding: 15px;

    flex-direction: column;

    align-items: stretch;

    background: #101216;

    border: 1px solid var(--border);

    border-radius: 14px;
  }

  .nav-links.open {
    display: flex;
  }

  .menu {
    display: block;
  }

  .hero {
    padding: 76px 0 55px;
  }

  h1 {
    font-size: clamp(45px, 15vw, 68px);
  }

  .url-box {
    flex-direction: column;

    padding: 7px;
  }

  .url-icon {
    display: none;
  }

  #urlInput {
    width: 100%;

    padding: 16px 13px;

    min-height: 52px;
  }

  .analyze-btn {
    min-height: 52px;
  }

  .media-info {
    align-items: flex-start;
  }

  .thumbnail {
    width: 110px;
  }

  .media-title {
    white-space: normal;

    font-size: 16px;
  }

  .formats,
  .feature-grid,
  .steps {
    grid-template-columns: 1fr;
  }

  .section {
    padding: 55px 0;
  }

  .footer-inner {
    flex-direction: column;

    align-items: flex-start;
  }
}

@media (max-width: 430px) {
  .media-info {
    flex-direction: column;
  }

  .thumbnail {
    width: 100%;

    aspect-ratio: 16 / 8;
  }
}